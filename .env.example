`# Copy to .env (never commit .env). All values below are placeholders.
DATABASE_URL=mysql+pymysql://root:YOUR_PASSWORD@localhost:3306/unicart?charset=utf8mb4
# Test suite uses a separate database `unicart_test` (rebuilt for every test)
TEST_DB_USER=root
TEST_DB_PASSWORD=YOUR_PASSWORD
# Random secret used to sign login tokens, e.g.  python -c "import secrets;print(secrets.token_urlsafe(48))"
JWT_SECRET=
JWT_EXPIRE_MINUTES=480
# Shared secret that the payment gateway / carrier / supplier send in the X-Partner-Secret header
PARTNER_SECRET=
# Extra browser origins allowed to call the API (the Vite dev proxy needs none)
CORS_ORIGINS=http://localhost:5173
# Seconds between sweeps that cancel unpaid online orders after 15 minutes (BR-04)
EXPIRY_SWEEP_SECONDS=30

# --- AI search (text, voice, image) with the Google Gemini API, free tier: https://aistudio.google.com/apikey
# Leave empty to disable AI: search then uses keywords only and the microphone / camera buttons are hidden.
GEMINI_API_KEY=
GEMINI_TEXT_MODEL=gemini-flash-lite-latest
GEMINI_FALLBACK_MODEL=gemini-3.5-flash-lite
GEMINI_EMBED_MODEL=gemini-embedding-001
GEMINI_EMBED_DIM=768
# Seconds to wait for Gemini: text search falls back to keywords after AI_QUERY_TIMEOUT (NFR-12)
AI_QUERY_TIMEOUT=2.0
AI_GENERATE_TIMEOUT=12

# --- Shopping assistant (chatbot, docs/CHATBOT.md). It uses the Gemini key above; without it the rule engine answers.
# Seconds per Gemini call / for a whole answer, after which the rule engine answers instead (free tier: 7-17 s per call)
CHAT_CALL_TIMEOUT=25
CHAT_TIMEOUT=50
# Messages up to this many words with a clear intent (promotions, shipping, "don #12"...) skip the model; 0 = always use it
CHAT_FAST_PATH_WORDS=12
# Demo return policy quoted by the chatbot: days after delivery
RETURN_WINDOW_DAYS=7
